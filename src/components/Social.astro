---
import github from '../assets/github.svg';
import linkedin from '../assets/linkedin.svg';
import mail from '../assets/mail.svg';
---
<div class="flex gap-x-3 gap-y-2.5 flex-wrap mt-2">
  <a
    class="motion-btn rounded-full border border-white/15 flex justify-center items-center gap-x-2.5 py-2 px-5 bg-white/5 hover:bg-white/10 hover:border-accent/50 text-sm font-medium text-white"
    href="https://github.com/Sixtebansito"
    target="_blank"
    rel="noopener noreferrer"
  >
    <img class="size-5 shrink-0" src={github.src} alt="" />
    GitHub
  </a>
  <a
    class="motion-btn rounded-full border border-white/15 flex justify-center items-center gap-x-2.5 py-2 px-5 bg-white/5 hover:bg-white/10 hover:border-accent/50 text-sm font-medium text-white"
    href="https://www.linkedin.com/in/esteban-munoz-/"
    target="_blank"
    rel="noopener noreferrer"
  >
    <img class="size-5 shrink-0" src={linkedin.src} alt="" />
    LinkedIn
  </a>
  <a
    class="motion-btn rounded-full border border-white/15 flex justify-center items-center gap-x-2.5 py-2 px-5 bg-white/5 hover:bg-white/10 hover:border-accent/50 text-sm font-medium text-white"
    href="mailto:dannygghhm@gmail.com"
  >
    <img class="size-5 shrink-0" src={mail.src} alt="" />
    dannygghhm@gmail.com
  </a>
</div>
