---
import github from '../assets/github.svg';
import linkedin from '../assets/linkedin.svg';
import mail from '../assets/mail.svg';
---
<div class="flex gap-x-4 gap-y-2 width-full max-[600px]:flex-wrap mt-3">
    <a class="rounded-full border border-white/10 flex justify-center items-center gap-x-2 py-1 px-5 bg-white/5 hover:scale-110 hover:bg-white/10 hover:text-white transition" href="https://github.com/Sixtebansito" target="_blank"><img class="w-8 h-8" src={github.src} alt="">GitHub</a>
    <a class="rounded-full border border-white/10 flex justify-center items-center gap-x-2 py-1 px-5 bg-white/5 hover:scale-110 hover:bg-white/10 hover:text-white transition" href="https://www.linkedin.com/in/esteban-munoz-/" target="_blank"><img class="w-8 h-8" src={linkedin.src} alt="">LinkedIn</a>
    <a class="rounded-full border border-white/10 flex justify-center items-center gap-x-2 py-1 px-5 bg-white/5 hover:scale-110 hover:bg-white/10 hover:text-white transition" href="mailto:dannygghhm@gmail.com"><img class="w-8 h-8" src={mail.src}  alt="">dannygghhm@gmail.com</a>
</div>