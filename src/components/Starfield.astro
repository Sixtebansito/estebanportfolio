<!-- Deep Interactive Starfield Canvas across full viewport -->
<canvas
  id="starfield-canvas"
  aria-hidden="true"
  class="fixed inset-0 w-full h-full pointer-events-none -z-10"
></canvas>

<script is:inline>
  (function () {
    const canvas = document.getElementById('starfield-canvas');
    if (!(canvas instanceof HTMLCanvasElement)) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isFinePointer = window.matchMedia('(pointer: fine)').matches;

    let width = 0;
    let height = 0;
    let dpr = 1;
    let stars = [];
    let shootingStar = null;
    let rafId = null;

    // Normalized mouse state for subtle depth parallax & nearby constellation glow
    const pointer = { x: -9999, y: -9999, nx: 0, ny: 0, targetNx: 0, targetNy: 0, active: false };

    function resize() {
      width = window.innerWidth;
      height = window.innerHeight;
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.floor(width * dpr);
      canvas.height = Math.floor(height * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      initStars();
      if (prefersReducedMotion) renderStatic();
    }

    function initStars() {
      const count = Math.min(Math.max(Math.floor((width * height) / 6200), 95), 240);
      stars = Array.from({ length: count }, () => {
        const isAccent = Math.random() < 0.24;
        const depth = Math.random() * 0.8 + 0.2;
        const radius = (Math.random() * 1.45 + 0.7) * (0.65 + depth * 0.5);
        return {
          x: Math.random() * width,
          y: Math.random() * height,
          depth,
          radius,
          baseAlpha: Math.random() * 0.55 + 0.35,
          twinklePhase: Math.random() * Math.PI * 2,
          twinkleSpeed: Math.random() * 0.025 + 0.008,
          driftY: -(0.03 + depth * 0.14),
          driftX: (Math.random() - 0.5) * 0.05,
          isAccent,
          hasHalo: Math.random() < 0.18,
        };
      });
    }

    function spawnShootingStar() {
      if (prefersReducedMotion || shootingStar) return;
      const startX = Math.random() * width * 0.75 + width * 0.1;
      const startY = Math.random() * height * 0.32;
      shootingStar = {
        x: startX,
        y: startY,
        vx: (Math.random() > 0.35 ? 1 : -1) * (9 + Math.random() * 4),
        vy: 4.2 + Math.random() * 2.5,
        life: 0,
        maxLife: 48,
      };
    }

    function renderStatic() {
      ctx.clearRect(0, 0, width, height);
      for (let i = 0; i < stars.length; i++) {
        const s = stars[i];
        ctx.beginPath();
        ctx.arc(s.x, s.y, s.radius, 0, Math.PI * 2);
        ctx.fillStyle = s.isAccent
          ? `rgba(56, 189, 248, ${s.baseAlpha})`
          : `rgba(248, 250, 252, ${s.baseAlpha})`;
        ctx.fill();
      }
    }

    function drawFrame() {
      ctx.clearRect(0, 0, width, height);

      // Smooth pointer parallax damping
      pointer.nx += (pointer.targetNx - pointer.nx) * 0.05;
      pointer.ny += (pointer.targetNy - pointer.ny) * 0.05;

      const nearCursor = [];

      for (let i = 0; i < stars.length; i++) {
        const s = stars[i];
        s.x += s.driftX;
        s.y += s.driftY;
        s.twinklePhase += s.twinkleSpeed;

        if (s.y < -6) {
          s.y = height + 6;
          s.x = Math.random() * width;
        } else if (s.x < -6) {
          s.x = width + 6;
        } else if (s.x > width + 6) {
          s.x = -6;
        }

        const px = s.x + pointer.nx * s.depth * 18;
        const py = s.y + pointer.ny * s.depth * 18;
        const twinkle = 0.68 + 0.32 * Math.sin(s.twinklePhase);
        let alpha = Math.min(1, s.baseAlpha * twinkle);
        let drawRadius = s.radius;

        if (pointer.active) {
          const dx = px - pointer.x;
          const dy = py - pointer.y;
          const distSq = dx * dx + dy * dy;
          if (distSq < 185 * 185) {
            const dist = Math.sqrt(distSq);
            const boost = 1 - dist / 185;
            alpha = Math.min(1, alpha + boost * 0.45);
            drawRadius += boost * 0.65;
            nearCursor.push({ px, py, boost });
          }
        }

        if (s.hasHalo) {
          const halo = ctx.createRadialGradient(px, py, 0, px, py, drawRadius * 4.2);
          halo.addColorStop(0, s.isAccent ? `rgba(56, 189, 248, ${alpha * 0.4})` : `rgba(255, 255, 255, ${alpha * 0.25})`);
          halo.addColorStop(1, 'rgba(0, 0, 0, 0)');
          ctx.beginPath();
          ctx.arc(px, py, drawRadius * 4.2, 0, Math.PI * 2);
          ctx.fillStyle = halo;
          ctx.fill();
        }

        ctx.beginPath();
        ctx.arc(px, py, drawRadius, 0, Math.PI * 2);
        ctx.fillStyle = s.isAccent
          ? `rgba(56, 189, 248, ${alpha})`
          : `rgba(248, 250, 252, ${alpha})`;
        ctx.fill();
      }

      // Delicate electric blue constellation web near pointer (up to 16 stars for O(1) cost)
      if (nearCursor.length > 1) {
        const cap = Math.min(nearCursor.length, 16);
        ctx.lineWidth = 0.7;
        for (let i = 0; i < cap; i++) {
          const a = nearCursor[i];
          for (let j = i + 1; j < cap; j++) {
            const b = nearCursor[j];
            const dx = a.px - b.px;
            const dy = a.py - b.py;
            const d2 = dx * dx + dy * dy;
            if (d2 < 115 * 115) {
              const lineAlpha = (1 - Math.sqrt(d2) / 115) * Math.min(a.boost, b.boost) * 0.32;
              if (lineAlpha > 0.015) {
                ctx.beginPath();
                ctx.moveTo(a.px, a.py);
                ctx.lineTo(b.px, b.py);
                ctx.strokeStyle = `rgba(56, 189, 248, ${lineAlpha})`;
                ctx.stroke();
              }
            }
          }
        }
      }

      if (shootingStar) {
        shootingStar.x += shootingStar.vx;
        shootingStar.y += shootingStar.vy;
        shootingStar.life += 1;
        const t = shootingStar.life / shootingStar.maxLife;
        const opacity = t < 0.25 ? t * 4 : Math.max(0, (1 - t) / 0.75);

        const grad = ctx.createLinearGradient(
          shootingStar.x,
          shootingStar.y,
          shootingStar.x - shootingStar.vx * 8,
          shootingStar.y - shootingStar.vy * 8
        );
        grad.addColorStop(0, `rgba(255, 255, 255, ${opacity * 0.95})`);
        grad.addColorStop(0.35, `rgba(56, 189, 248, ${opacity * 0.65})`);
        grad.addColorStop(1, 'rgba(16, 42, 67, 0)');

        ctx.beginPath();
        ctx.moveTo(shootingStar.x, shootingStar.y);
        ctx.lineTo(shootingStar.x - shootingStar.vx * 8, shootingStar.y - shootingStar.vy * 8);
        ctx.strokeStyle = grad;
        ctx.lineWidth = 1.8;
        ctx.stroke();

        if (shootingStar.life >= shootingStar.maxLife) shootingStar = null;
      }

      rafId = requestAnimationFrame(drawFrame);
    }

    if (isFinePointer && !prefersReducedMotion) {
      window.addEventListener(
        'pointermove',
        (e) => {
          if (e.pointerType !== 'mouse' && e.pointerType !== 'pen') return;
          pointer.x = e.clientX;
          pointer.y = e.clientY;
          pointer.targetNx = (e.clientX / Math.max(width, 1) - 0.5) * 2;
          pointer.targetNy = (e.clientY / Math.max(height, 1) - 0.5) * 2;
          pointer.active = true;
        },
        { passive: true }
      );

      document.documentElement.addEventListener('mouseleave', () => {
        pointer.active = false;
      });
    }

    resize();
    window.addEventListener('resize', resize, { passive: true });

    if (!prefersReducedMotion) {
      rafId = requestAnimationFrame(drawFrame);
      const timer = setInterval(spawnShootingStar, 7500);
      setTimeout(spawnShootingStar, 2000);
      document.addEventListener('visibilitychange', () => {
        if (document.hidden && rafId) {
          cancelAnimationFrame(rafId);
          rafId = null;
        } else if (!document.hidden && !rafId) {
          rafId = requestAnimationFrame(drawFrame);
        }
      });
      window.addEventListener('beforeunload', () => clearInterval(timer), { once: true });
    }
  })();
</script>
