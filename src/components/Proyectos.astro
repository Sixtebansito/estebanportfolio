  HTML: {
    name: "HTML5",
    class: "bg-[#E34F26] text-white",
    icon: `<svg class="size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M20 4l-2 14.5l-6 2l-6 -2l-2 -14.5z" /><path d="M15.5 8h-7l.5 4h6l-.5 3.5l-2.5 .75l-2.5 -.75l-.1 -1.5" /></svg>`,
  },
  CSS: {
    name: "CSS3",
    class: "bg-[#1572B6] text-white",
    icon: `<svg class="size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M20 4l-2 14.5l-6 2l-6 -2l-2 -14.5z" /><path d="M8.5 8h7l-.5 4h-6l.5 3.5l2.5 .75l2.5 -.75l.1 -1.5" /></svg>`,
  },
  KUBERNETES: {
    name: "Cloud & K8s",
    class: "bg-[#326CE5] text-white",
    icon: `<svg class="size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>`,
  }
}

interface Proyecto {
  title: string;
  category: string;
  description: string;
  image: string;
  tags: { name: string; class: string; icon: string }[];
  github?: string;
  link?: string;
}

const PROYECTOS: Proyecto[] = [
  {
    title: "ETRIEN S.A.S. - Arquitectura Corporativa B2B",
    category: "Sitio Corporativo & B2B",
    description: "Plataforma web empresarial para optimizar procesos internos y proyectar autoridad comercial. Arquitectura modular de alto rendimiento con diseño minimalista y componentes interactivos.",
    image: etrienImg.src,
    tags: [TAGS.REACT, TAGS.TAILWIND, TAGS.JAVASCRIPT]
  },
  {
    title: "TicketNow - E-commerce de Eventos",
    category: "Comercio Electrónico",
    description: "Plataforma de venta y reserva de boletos con arquitectura 'Dark First' inspirada en la Gen-Z. Carrito reactivo, cálculo dinámico y experiencia fluida optimizada para alta conversión.",
    image: ticketnowImg.src, 
    tags: [TAGS.ASTRO, TAGS.JAVASCRIPT, TAGS.TAILWIND]
  },
  {
    title: "Catálogo & E-Commerce de Plantas Online",
    category: "Tienda Online (Cert. IBM)",
    description: "Aplicación interactiva de comercio electrónico para catálogo botánico. Lógica de selección de productos, gestión de carrito y checkout intuitivo desarrollada bajo estándares IBM Cloud.",
    github: "https://github.com/Sixtebansito/e-plantShopping",
    image: Plantas.src,
    tags: [TAGS.ASTRO, TAGS.TAILWIND, TAGS.JAVASCRIPT],
  },
  {
    title: "Portal de Reseñas de Concesionarios Automotrices",
    category: "Capstone Full Stack Cloud",
    description: "Proyecto final Full Stack de IBM. Backend en Django con arquitectura de microservicios, contenedorizado con Docker y desplegado en Kubernetes y Red Hat OpenShift en IBM Cloud.",
    image: car.src,
    tags: [TAGS.DJANGO, TAGS.PYTHON, TAGS.KUBERNETES],
  },
  {
    title: "Análisis y Telemetría Predictiva de APIs",
    category: "Data Science & Performance",
    description: "Modelo predictivo para analizar la correlación entre concurrencia de usuarios y latencia en servicios REST. Implementado con Scikit-Learn, regresión polinómica y visualización en Pandas.",
    image: telemetriaImg.src,
    tags: [TAGS.PYTHON],
  },
  {
    title: "Catfeteria - Cafetería Temática & Adopciones",
    category: "Diseño Web UI/UX",
    description: "Plataforma web interactiva para cafetería temática felina y centro de rescate. Menú digital, perfiles interactivos de adopción y diseño visual atractivo y adaptable.",
    image: catfeteriaImg.src,
    tags: [TAGS.HTML, TAGS.CSS, TAGS.JAVASCRIPT],
  },
  {
    title: "Algoritmos & Estructuras de Lógica Computacional",
    category: "Desarrollo Backend",
    description: "Suite de resolución algorítmica y procesamiento estructurado de datos en Python, enfocada en optimización de complejidad temporal y validaciones robustas.",
    image: fundamentosImg.src,
    tags: [TAGS.PYTHON],
  }
]
---

<section id="proyectos" class="py-32 bg-[#111111]">
  <div class="max-w-7xl mx-auto px-6 mb-16 text-center reveal">
    <span class="glint-subheading">Portafolio Seleccionado</span>
    <h2 class="text-4xl md:text-5xl font-bold text-white mt-2">
      Proyectos recientes & <span class="text-accent">soluciones digitales.</span>
    </h2>
    <p class="text-gray-400 max-w-2xl mx-auto text-base mt-4">
      Cada proyecto refleja el equilibrio entre código limpio, experiencia de usuario agradable y alineación estratégica de negocio.
    </p>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {
      PROYECTOS.map(({ image, title, category, description, tags, link, github }, index) => (
        <article 
          class="relative group overflow-hidden bg-[#151515] rounded-2xl border border-white/5 hover:border-accent/40 transition-all duration-500 shadow-xl flex flex-col justify-between reveal"
          style={`animation-delay: ${index * 80}ms;`}
        >
          <!-- Project Image & Overlay -->
          <div class="relative aspect-[16/10] overflow-hidden">
            <img 
              alt={`Proyecto: ${title}`} 
              loading="lazy" 
              src={image} 
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-108"
            />
            
            <!-- Category Badge -->
            <span class="absolute top-3 left-3 px-3 py-1 bg-black/70 backdrop-blur-md text-[11px] font-bold uppercase tracking-wider text-accent border border-white/10 rounded-full z-10">
              {category}
            </span>

            <!-- Desktop Hover Overlay with details -->
            <div class="absolute inset-0 bg-black/85 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col justify-center items-center p-6 text-center z-20">
              <p class="text-xs text-gray-300 mb-4 leading-relaxed line-clamp-4">
                {description}
              </p>
              
              <!-- Action buttons -->
              <div class="flex gap-3">
                {github && (
                  <a 
                    href={github} 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    aria-label={`Ver código fuente de ${title} en GitHub`}
                    class="px-4 py-2 rounded-full border border-white/20 hover:border-accent bg-white/5 hover:bg-accent text-white text-xs font-semibold flex items-center gap-1.5 transition-colors"
                  >
                    <svg class="size-4" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                    </svg>
                    Código
                  </a>
                )}
                {link && (
                  <a 
                    href={link} 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    aria-label={`Ver demo en vivo de ${title}`}
                    class="px-4 py-2 rounded-full bg-accent hover:bg-accent-hover text-white text-xs font-semibold flex items-center gap-1.5 transition-colors"
                  >
                    <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                      <polyline points="15 3 21 3 21 9"></polyline>
                      <line x1="10" y1="14" x2="21" y2="3"></line>
                    </svg>
                    Ver Demo
                  </a>
                )}
              </div>
            </div>
          </div>
          
          <!-- Card Info -->
          <div class="p-6 flex flex-col justify-between flex-1">
            <div>
              <h3 class="text-xl font-bold text-white mb-2 group-hover:text-accent transition-colors">
                {title}
              </h3>
              <p class="text-sm text-gray-400 line-clamp-2 mb-4">
                {description}
              </p>
            </div>

            <!-- Tags -->
            <div class="flex flex-wrap gap-2 pt-2 border-t border-white/5">
              {tags.map((tag) => (
                <span class={`inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-medium ${tag.class}`}>
                  <Fragment set:html={tag.icon} />
                  {tag.name}
                </span>
              ))}
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>