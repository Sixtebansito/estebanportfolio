---
import car from "../assets/Cardealer.png"
import Plantas from "../assets/plantas.png"
import etrienImg from "../assets/etrien-preview.png" 
import ticketnowImg from "../assets/ticketnow-preview.png"
import catfeteriaImg from "../assets/catfeteria.jpg"
import telemetriaImg from "../assets/telemetria.jpg"
import movingllcImg from "../assets/movingllc.png"
import arlenesImg from "../assets/arlenes-cleaning.png"
const TAGS = {
  ASTRO: {
    name: "Astro",
    class: "bg-[#23262F] text-white",
    icon: `<svg class="size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M3 16.594v-.594a4 4 0 0 1 4 -4h10a4 4 0 0 1 4 4v.594c0 .822 -.306 1.614 -.864 2.22l-1.01 1.094a3.9 3.9 0 0 1 -2.87 1.258h-8.512a3.9 3.9 0 0 1 -2.87 -1.258l-1.01 -1.094a3.109 3.109 0 0 1 -.864 -2.22z" /><path d="M12 12v-6.382a2.3 2.3 0 0 1 3.514 -1.95l1.644 1.012" /><path d="M12 12v-6.382a2.3 2.3 0 0 0 -3.514 -1.95l-1.644 1.012" /></svg>`,
  },
  TAILWIND: {
    name: "Tailwind CSS",
    class: "bg-[#003159] text-white",
    icon: `<svg class="size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M11.667 6c-2.49 0 -4.044 1.222 -4.667 3.667c.933 -1.223 2.023 -1.68 3.267 -1.375c.71 .174 1.217 .68 1.778 1.24c.916 .912 2 1.968 4.288 1.968c2.49 0 4.044 -1.222 4.667 -3.667c-.933 1.223 -2.023 1.68 -3.267 1.375c-.71 -.174 -1.217 -.68 -1.778 -1.24c-.916 -.912 -2 -1.968 -4.288 -1.968zm-5.334 6.333c-2.49 0 -4.044 1.222 -4.667 3.667c.933 -1.223 2.023 -1.68 3.267 -1.375c.71 .174 1.217 .68 1.778 1.24c.916 .912 2 1.968 4.288 1.968c2.49 0 4.044 -1.222 4.667 -3.667c-.933 1.223 -2.023 1.68 -3.267 1.375c-.71 -.174 -1.217 -.68 -1.778 -1.24c-.916 -.912 -2 -1.968 -4.288 -1.968z" /></svg>`,
  },
  REACT: {
    name: "React",
    class: "bg-[#23272F] text-[#149ECA]",
    icon: `<svg class="size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M6.306 8.711c-2.602 .723 -4.306 1.926 -4.306 3.289c0 2.21 4.477 4 10 4c5.523 0 10 -1.79 10 -4c0 -1.363 -1.704 -2.566 -4.306 -3.289" /><path d="M17.694 15.289c2.602 -.723 4.306 -1.926 4.306 -3.289c0 -2.21 -4.477 -4 -10 -4c-5.523 0 -10 1.79 -10 4c0 1.363 1.704 2.566 4.306 3.289" /><path d="M12 12m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0" /><path d="M8.058 16.634c-.878 -1.637 -1.011 -3.518 -.361 -5.029c1.01 -2.35 4.14 -3.125 6.993 -1.732c2.853 1.393 4.348 4.425 3.338 6.775c-.65 1.51 -2.186 2.378 -3.97 2.457" /><path d="M15.942 7.366c.878 1.637 1.011 3.518 .361 5.029c-1.01 2.35 -4.14 3.125 -6.993 1.732c-2.853 -1.393 -4.348 -4.425 -3.338 -6.775c.65 -1.51 2.186 -2.378 3.97 -2.457" /></svg>`,
  },
  JAVASCRIPT: {
    name: "JavaScript",
    class: "bg-[#F7DF1E] text-white hover:bg-[#E5C918]",
    icon: `<svg class="size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M20 4l-2 14.5l-6 2l-6 -2l-2 -14.5z" /><path d="M7.5 8h3v8l-2 -1" /><path d="M16.5 8h-2.5a.5 .5 0 0 0 -.5 .5v3a.5 .5 0 0 0 .5 .5h1.423a.5 .5 0 0 1 .495 .57l-.418 2.93l-2 .5" /></svg>`,
  },
  DJANGO: {
    name: "Django",
    class: "bg-[#092E20] text-white",
    icon: `<svg class="size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M11.146 1.054v14.475c-1.391.229-2.76.34-4.103.34-1.636 0-3.003-.306-4.103-.918-1.096-.613-1.884-1.464-2.362-2.553C.1 11.31 0 10.04 0 8.583V1.054h2.894v7.712c0 1.25.138 2.22.414 2.91.276.689.722 1.22 1.336 1.595.613.377 1.401.564 2.363.564 1.156 0 2.457-.143 3.904-.429V1.054h.235zm11.316.326c-.307.245-.583.567-.827.965-.245.398-.445.864-.598 1.395-.152.531-.229 1.127-.229 1.788v6.763c0 1.052-.107 1.948-.321 2.688-.214.74-.531 1.34-.952 1.8-.42.46-.967.815-1.64 1.066-.673.25-1.488.375-2.443.375-1.533 0-3.155-.244-4.868-.734v-3.085c1.455.52 2.871.78 4.249.78 1.424 0 2.502-.336 3.233-1.01.73-.674 1.095-1.685 1.095-3.033V1.38h2.834zm-8.86 16.92c.69 0 1.25-.192 1.678-.575.43-.383.644-.882.644-1.494 0-.612-.214-1.11-.644-1.493-.428-.383-.988-.574-1.678-.574-.69 0-1.25.191-1.678.574-.429.383-.644.881-.644 1.493 0 .612.215 1.111.644 1.494.428.383.988.575 1.678.575z"/></svg>`,
  },
  PYTHON: {
    name: "Python",
    class: "bg-[#3776AB] text-white",
    icon: `<svg class="size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M12 2c-4.66 0 -8.5 3.31 -8.96 7.73l-.04 .27v4l.03 .24c.33 2.65 2.14 4.8 4.71 5.48l.26 .06v-3.78c0 -1.65 1.34 -3 3 -3h5v-5c0 -3.31 -2.69 -6 -6 -6zm-1 4a1 1 0 1 1 0 2a1 1 0 0 1 0 -2zm10 4h-5v5c0 3.31 2.69 6 6 6c4.66 0 8.5 -3.31 8.96 -7.73l.04 -.27v-4l-.03 -.24c-.33 -2.65 -2.14 -4.8 -4.71 -5.48l-.26 -.06v3.78c0 1.65 -1.34 3 -3 3h-5z"/></svg>`,
  },
  HTML: {
    name: "HTML",
    class: "bg-[#E34F26] text-white",
    icon: `<svg class="size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M20 4l-2 14.5l-6 2l-6 -2l-2 -14.5z" /><path d="M15.5 8h-7l.5 4h6l-.5 3.5l-2.5 .75l-2.5 -.75l-.1 -1.5" /></svg>`,
  },
  CSS: {
    name: "CSS",
    class: "bg-[#1572B6] text-white",
    icon: `<svg class="size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M20 4l-2 14.5l-6 2l-6 -2l-2 -14.5z" /><path d="M8.5 8h7l-.5 4h-6l.5 3.5l2.5 .75l2.5 -.75l.1 -1.5" /></svg>`,
  },
}

interface Proyecto {
  title: string;
  description: string;
  image: string;
  tags: { name: string; class: string; icon: string }[];
  github?: string;
  link?: string;
}

const PROYECTOS: Proyecto[] = [
  {
    title: "Arlene's Cleaning Company LLC",
    description: "Incrementé la conversión de clientes potenciales en un 35 por ciento desarrollando un cotizador web instantáneo que calcula tarifas automáticas por área y frecuencia en menos de 200 milisegundos con accesibilidad web completa en React 18 y TypeScript.",
    image: arlenesImg.src,
    link: "https://arlenes-cleaning.vercel.app/",
    tags: [TAGS.REACT, TAGS.TAILWIND, TAGS.JAVASCRIPT]
  },
  {
    title: "David's Moving Services & Logistics",
    description: "Reduje el abandono de solicitudes de cotización en un 40 por ciento implementando una calculadora de volumen en metros cúbicos y pies cúbicos con estado reactivo y validación de formularios en tiempo real.",
    image: movingllcImg.src,
    link: "https://movingllc.vercel.app/",
    tags: [TAGS.REACT, TAGS.TAILWIND, TAGS.JAVASCRIPT]
  },
  {
    title: "TicketNow - E-commerce de Entradas",
    description: "Logré un tiempo de interactividad inferior a 0.8 segundos construyendo una plataforma web de entradas en Astro con carrito de compras persistente y filtrado dinámico de eventos sin recarga de página.",
    image: ticketnowImg.src,
    link: "https://ticketnow-astro.vercel.app/",
    github: "https://github.com/Sixtebansito/ticketnow-astro",
    tags: [TAGS.ASTRO, TAGS.JAVASCRIPT, TAGS.TAILWIND]
  },
  {
    title: "Catfeteria - Cafetería Temática y Adopciones",
    description: "Desarrollé una plataforma web interactiva orientada a la experiencia de usuario con catálogo visual de mascotas en adopción, menús dinámicos y diseño responsivo accesible.",
    image: catfeteriaImg.src,
    link: "https://catfeteria.vercel.app/",
    github: "https://github.com/Sixtebansito/Catfeteria",
    tags: [TAGS.HTML, TAGS.CSS, TAGS.JAVASCRIPT]
  },
  {
    title: "Dealership Reviews - Plataforma Distribuida de Microservicios",
    description: "Aseguré un 99.9 por ciento de disponibilidad y desacoplamiento de servicios containerizando con Docker un backend en Django comunicado con un microservicio de reseñas de usuarios en Node.js sobre base de datos NoSQL.",
    github: "https://github.com/Sixtebansito/xrwvm-fullstack_developer_capstone",
    image: car.src,
    tags: [TAGS.DJANGO, TAGS.TAILWIND, TAGS.ASTRO]
  },
  {
    title: "ETRIEN S.A.S. - Arquitectura Corporativa B2B",
    description: "Diseñé e integré módulos frontend interactivos y arquitectura de componentes reutilizables orientados a optimizar la gestión y procesos comerciales de la empresa.",
    image: etrienImg.src,
    tags: [TAGS.REACT, TAGS.TAILWIND]
  },
  {
    title: "Tienda de Plantas Online - Carrito y Catálogo",
    description: "Implementé la lógica de estado de carrito de compras, catálogo dinámico interactivo y administración ágil de pedidos para e-commerce.",
    github: "https://github.com/Sixtebansito/e-plantShopping",
    image: Plantas.src,
    tags: [TAGS.ASTRO, TAGS.TAILWIND, TAGS.JAVASCRIPT]
  },
  {
    title: "Análisis de Telemetría API",
    description: "Proyecto de análisis de datos para correlacionar la latencia de una API con los usuarios concurrentes, utilizando regresión lineal y ajuste de curvas con Scikit-Learn y Pandas.",
    image: telemetriaImg.src,
    tags: [TAGS.PYTHON]
  }
]
---

<section id="proyectos" class="scroll-mt-16 py-32 bg-transparent border-t border-white/5">
  <div class="max-w-7xl mx-auto px-6 mb-16 text-center reveal">
    <span class="glint-subheading" data-i18n="proj.sub">Trabajos Recientes</span>
    <h2 class="text-4xl md:text-5xl font-bold text-white mt-2" data-i18n="proj.title">
      Me encanta lo que hago, revisa <span class="text-accent">mis proyectos.</span>
    </h2>
  </div>

  <div class="max-w-screen-2xl mx-auto px-4 sm:px-6 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {
      PROYECTOS.map(({ image, title, description, tags, link, github }, index) => (
        <article
          class="relative group overflow-hidden bg-[#151514]/60 backdrop-blur-md rounded-2xl border border-white/10 aspect-[4/3] reveal motion-card shadow-xl"
          style={`transition-delay: ${(index % 3) * 80}ms;`}
        >
          <!-- Project Image -->
          <img
            alt={`Proyecto: ${title}`}
            loading="lazy"
            src={image}
            class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
          />

          <!-- Persistent Mobile / Default Bottom Caption Dock (fades on desktop hover) -->
          <div class="absolute inset-x-0 bottom-0 pt-14 pb-4 px-4 sm:px-5 sm:pb-5 bg-gradient-to-t from-black via-black/92 to-transparent flex items-end justify-between gap-3 transition-opacity duration-200 md:group-hover:opacity-0 md:group-focus-within:opacity-0">
            <div class="min-w-0">
              <h3 class="text-base sm:text-lg font-bold text-white truncate" data-i18n={`proj.${index}.title`}>
                {title}
              </h3>
              <div class="flex flex-wrap gap-1.5 mt-1.5">
                {tags.slice(0, 3).map((tag) => (
                  <span class="px-2 py-0.5 rounded bg-accent/15 border border-accent/30 text-[10px] uppercase tracking-wider text-accent font-bold">
                    {tag.name}
                  </span>
                ))}
              </div>
            </div>

            {(github || link) && (
              <div class="flex items-center gap-2 shrink-0">
                {github && (
                  <a
                    href={github}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`GitHub ${title}`}
                    class="motion-btn size-10 rounded-full bg-black/75 border border-white/25 hover:border-accent hover:bg-accent flex items-center justify-center text-white"
                  >
                    <svg class="size-4" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                      <path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5" />
                    </svg>
                  </a>
                )}
                {link && (
                  <a
                    href={link}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`Demo ${title}`}
                    class="motion-btn size-10 rounded-full bg-accent/90 border border-accent hover:bg-accent flex items-center justify-center text-white shadow-md"
                  >
                    <svg class="size-4" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                      <path d="M12 6h-6a2 2 0 0 0 -2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-6" />
                      <path d="M11 13l9 -9" />
                      <path d="M15 4h5v5" />
                    </svg>
                  </a>
                )}
              </div>
            )}
          </div>

          <!-- Desktop Hover / Focus Full Detail Overlay -->
          <div class="hidden md:flex absolute inset-0 bg-black/88 backdrop-blur-xs opacity-0 group-hover:opacity-100 group-focus-within:opacity-100 transition-opacity duration-250 flex-col justify-center items-center p-7 text-center">
            <p aria-hidden="true" class="text-xl md:text-2xl font-bold text-white mb-2 translate-y-3 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:translate-y-0 group-focus-within:opacity-100 transition-[opacity,transform] duration-300 ease-out delay-50" data-i18n={`proj.${index}.title`}>
              {title}
            </p>

            <p class="text-sm text-gray-300 mb-5 translate-y-3 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:translate-y-0 group-focus-within:opacity-100 transition-[opacity,transform] duration-300 ease-out delay-100 line-clamp-3" data-i18n={`proj.${index}.desc`}>
              {description}
            </p>

            <!-- Tags -->
            <div class="flex flex-wrap justify-center gap-2 mb-5 translate-y-3 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:translate-y-0 group-focus-within:opacity-100 transition-[opacity,transform] duration-300 ease-out delay-150">
              {tags.map((tag) => (
                <span class="px-2 py-0.5 rounded bg-accent/15 border border-accent/25 text-xs uppercase tracking-wider text-accent font-bold">
                  {tag.name}
                </span>
              ))}
            </div>

            <!-- Links -->
            <div class="flex gap-3 translate-y-3 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:translate-y-0 group-focus-within:opacity-100 transition-[opacity,transform] duration-300 ease-out delay-200">
              {github && (
                <a href={github} target="_blank" rel="noopener noreferrer" aria-label={`GitHub ${title}`} class="motion-btn inline-flex items-center gap-2 px-4 h-11 rounded-full border border-white/25 hover:border-accent hover:bg-accent text-xs font-bold uppercase tracking-wider text-white">
                  <svg class="size-4" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                    <path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5" />
                  </svg>
                  <span>Code</span>
                </a>
              )}
              {link && (
                <a href={link} target="_blank" rel="noopener noreferrer" aria-label={`Demo ${title}`} class="motion-btn inline-flex items-center gap-2 px-4 h-11 rounded-full bg-accent border border-accent hover:bg-accent-hover text-xs font-bold uppercase tracking-wider text-white shadow-lg">
                  <svg class="size-4" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                    <path d="M12 6h-6a2 2 0 0 0 -2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-6" />
                    <path d="M11 13l9 -9" />
                    <path d="M15 4h5v5" />
                  </svg>
                  <span>Live</span>
                </a>
              )}
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>