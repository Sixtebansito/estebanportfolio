---
import Image from "../assets/foto.jpg"
import Badge from "../components/Badge.astro"
import Social from "../components/Social.astro"
import FloatingIcons from "./FloatingIcons.astro"
---
<div class="relative flex flex-col items-center justify-center min-h-[70vh]">
  <FloatingIcons />
  
  <nav class="relative z-10 w-full max-w-4xl px-4 mx-auto">
  <div class="flex flex-col items-center gap-6 mb-8">
    <div class="relative group">
      <div class="absolute inset-0 transition-opacity duration-500 rounded-full opacity-0 bg-gradient-to-r from-blue-500 via-purple-500 to-pink-500 blur-xl group-hover:opacity-60 animate-pulse"></div>
      <img
        class="relative rounded-full shadow-2xl size-40 object-cover border-4 border-white/10 transition-transform duration-500 group-hover:scale-105"
        src={Image.src}
        alt="Foto de Esteban"
      />
    </div>
    <a
      href="https://www.linkedin.com/in/esteban-munoz-/"
      target="_blank"
      rel="noopener"
      class="flex items-center transition md:justify-center md:hover:scale-105"
    >
      <Badge>Disponible para trabajar</Badge>
    </a>
  </div>
  <div class="flex flex-col items-center text-center gap-y-6">
    <h1 class="text-5xl font-extrabold tracking-tight sm:text-7xl">
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-indigo-400 to-purple-400">
        Hola Soy Esteban!
      </span>
    </h1>
    <p class="max-w-2xl mt-4 text-xl text-gray-800 dark:text-gray-300 leading-relaxed text-pretty">
      <strong class="text-transparent bg-clip-text bg-gradient-to-r from-yellow-400 to-yellow-600 font-bold">Licenciado en Negocios Internacionales y Estudiante de Desarrollo de Software</strong>
      <br />
      <span class="opacity-80">de Quito, Ecuador</span>
    </p>
    <Social></Social>
    <button id="download-cv" class="mt-8 px-8 py-3 text-white bg-white/10 hover:bg-white/20 backdrop-blur-md font-semibold rounded-full shadow-[0_0_15px_rgba(255,255,255,0.1)] hover:shadow-[0_0_25px_rgba(255,255,255,0.3)] transition-all transform hover:scale-105 hover:-translate-y-1 flex items-center gap-3 border border-white/20">
      <svg class="size-5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2 -2v-2" /><path d="M7 11l5 5l5 -5" /><path d="M12 4l0 12" /></svg>
      Descargar CV
    </button>
  </div>
  </nav>
</div>

<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
<script>
  document.getElementById('download-cv')?.addEventListener('click', function() {
    const btn = this as HTMLButtonElement;
    const originalText = btn.innerHTML;
    btn.innerText = 'Generando PDF...';
    btn.disabled = true;

    // Temporalmente ocultamos elementos que no deben ir en el CV como el propio botón
    btn.style.display = 'none';

    const element = document.querySelector('main');
    
    const opt = {
      margin:       0.5,
      filename:     'Esteban_Munoz_CV.pdf',
      image:        { type: 'jpeg', quality: 0.98 },
      html2canvas:  { scale: 2, useCORS: true, windowWidth: 1024 },
      jsPDF:        { unit: 'in', format: 'a4', orientation: 'portrait' }
    };
    
    // @ts-ignore
    html2pdf().set(opt).from(element).save().then(() => {
      btn.innerHTML = originalText;
      btn.disabled = false;
      btn.style.display = 'flex';
    });
  });
</script>