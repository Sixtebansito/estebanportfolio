---
import Social from "../components/Social.astro"
import FloatingIcons from "./FloatingIcons.astro"
import Image from "../assets/foto.jpg"
---
<section id="inicio" class="relative flex flex-col justify-center min-h-screen px-6 overflow-hidden bg-[#111111]">
  <!-- Floating Icons Animation -->
  <FloatingIcons />
  
  <div class="relative z-10 w-full max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between mt-16 md:mt-0 gap-12">
    <!-- Left Content -->
    <div class="flex flex-col gap-6 max-w-2xl">
      <span class="glint-subheading reveal">Bienvenido a mi mundo</span>
      
      <h1 class="text-5xl md:text-7xl lg:text-8xl font-black tracking-tighter text-white leading-tight reveal" style="animation-delay: 200ms;">
        Hola, soy Esteban.<br />
        <span class="text-white/60 font-medium text-3xl md:text-5xl lg:text-6xl tracking-tight block mt-2">
          Estudiante de software & <span class="text-accent">solucionador de problemas.</span>
        </span>
      </h1>
      
      <div class="flex flex-col sm:flex-row gap-6 mt-8 reveal" style="animation-delay: 400ms;">
        <button id="download-cv" class="px-8 py-4 text-white uppercase tracking-widest text-sm font-bold bg-accent hover:bg-accent-hover transition-colors rounded-sm flex items-center justify-center gap-3">
          <svg class="size-5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2 -2v-2" /><path d="M7 11l5 5l5 -5" /><path d="M12 4l0 12" /></svg>
          Descargar CV
        </button>
        <a href="#sobre-mi" class="px-8 py-4 text-white uppercase tracking-widest text-sm font-bold border-2 border-white/20 hover:border-white transition-colors rounded-sm flex items-center justify-center">
          Más sobre mí
        </a>
      </div>
      
      <div class="mt-12 reveal" style="animation-delay: 600ms;">
        <Social />
      </div>
    </div>

    <!-- Right Content: Profile Picture -->
    <div class="relative group reveal" style="animation-delay: 800ms;">
      <div class="absolute inset-0 transition-opacity duration-500 rounded-full opacity-0 bg-gradient-to-r from-blue-500 via-purple-500 to-pink-500 blur-xl group-hover:opacity-60 animate-pulse"></div>
      <img
        class="relative rounded-full shadow-2xl size-56 md:size-72 lg:size-80 object-cover border-4 border-white/10 transition-transform duration-500 group-hover:scale-105"
        src={Image.src}
        alt="Foto de Esteban"
      />
    </div>
  </div>

  <!-- Scroll Down Indicator -->
  <div class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 reveal opacity-50 hover:opacity-100 transition-opacity">
    <span class="uppercase tracking-[0.2em] text-xs font-bold text-accent">Scroll</span>
    <div class="w-[2px] h-12 bg-white/20 relative overflow-hidden">
      <div class="absolute top-0 left-0 w-full h-1/2 bg-accent animate-[scrolldown_1.5s_ease-in-out_infinite]"></div>
    </div>
  </div>
</section>

<style>
  @keyframes scrolldown {
    0% { transform: translateY(-100%); }
    100% { transform: translateY(200%); }
  }
</style>

<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
<script>
  document.getElementById('download-cv')?.addEventListener('click', function() {
    const btn = this as HTMLButtonElement;
    const originalText = btn.innerHTML;
    btn.innerHTML = 'Generando...';
    btn.disabled = true;
    btn.style.opacity = '0.5';

    const element = document.querySelector('main');
    
    const opt = {
      margin:       0.5,
      filename:     'Esteban_Munoz_CV.pdf',
      image:        { type: 'jpeg', quality: 0.98 },
      html2canvas:  { scale: 2, useCORS: true, windowWidth: 1024, ignoreElements: (element) => element.tagName === 'ASTRO-DEV-TOOLBAR' },
      jsPDF:        { unit: 'in', format: 'a4', orientation: 'portrait' }
    };
    
    // @ts-ignore
    html2pdf().set(opt).from(element).save().then(() => {
      btn.innerHTML = originalText;
      btn.disabled = false;
      btn.style.opacity = '1';
    }).catch((err) => {
      console.error("Error al generar PDF: ", err);
      btn.innerHTML = originalText;
      btn.disabled = false;
      btn.style.opacity = '1';
      alert("Hubo un error al generar el PDF. Asegúrate de probarlo en producción (GitHub Pages), ya que Astro Dev Toolbar puede interferir en desarrollo local.");
    });
  });
</script>