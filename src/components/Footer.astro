---
const currentYear = new Date().getFullYear()
---

<footer class="w-full border-t border-white/10 bg-[#0b0b0b]/90 py-10 px-6 mt-8">
  <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4">
    <span class="text-sm text-gray-400 text-center sm:text-left">
      &copy; {currentYear}
      <a href="#inicio" class="hover:underline text-accent font-medium">Esteban Muñoz</a>.
      <span data-i18n="footer.rights">Casi todos los derechos reservados</span>
    </span>
    <ul class="flex flex-wrap items-center gap-6 text-sm font-medium text-gray-300">
      <li>
        <a href="#sobre-mi" data-i18n="footer.about" class="hover:text-accent transition-colors duration-200">Sobre mí</a>
      </li>
      <li>
        <a href="#estudios" data-i18n="nav.education" class="hover:text-accent transition-colors duration-200">Estudios</a>
      </li>
      <li>
        <a id="contacto-footer" href="mailto:dannygghhm@gmail.com" data-i18n="footer.contact" class="hover:text-accent transition-colors duration-200">
          Contacto
        </a>
      </li>
    </ul>
  </div>
</footer>
