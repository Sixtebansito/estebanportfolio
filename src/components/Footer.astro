---
const currentYear = new Date().getFullYear()
---

<footer
  class="opacity-80 m-4 min-[375px]:pl-4 md:pl-0 mt-16 w-full mx-auto container lg:max-w-4xl md:max-w-2xl mb-10 flex justify-center"
>
  <div
    class="rounded-lg w-full max-w-7xl mx-auto md:flex md:items-center md:justify-between py-4"
  >
    <span class="text-sm sm:text-center text-zinc-800/90 dark:text-zinc-200/90"
      >&copy; {currentYear}
      <a href="https://sixtebansito.github.io/estebanportfolio/" class="hover:underline text-accent">Esteban Muñoz</a>. <span data-i18n="footer.rights">Casi todos los derechos reservados</span>
    </span>
    <ul
      class="flex flex-wrap items-center mt-3 text-sm font-medium dark:text-white/90 sm:mt-0"
    >
      <li>
        <a href="#sobre-mi" data-i18n="footer.about" class="hover:underline me-4 md:me-6">Sobre mí</a>
      </li>
      <li>
        <a id="contacto-footer" href="mailto:dannygghhm@gmail.com" data-i18n="footer.contact" class="hover:underline"
          >Contacto</a
        >
      </li>
    </ul>
  </div>
</footer>