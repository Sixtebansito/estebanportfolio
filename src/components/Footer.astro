---

<footer class="w-full border-t border-white/10 bg-[#070908]/45 backdrop-blur-md py-10 px-6 mt-8">
  <div class="max-w-7xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-4 text-sm text-gray-400">
    <p class="text-center sm:text-left">
      © {new Date().getFullYear()}{" "}
      <a href="#inicio" class="text-accent hover:underline font-semibold">Esteban Muñoz</a>.{" "}
      <span data-i18n="footer.rights">Casi todos los derechos reservados</span>
    </p>

    <ul class="flex flex-wrap justify-center items-center gap-x-6 gap-y-2 font-medium">
      <li>
        <a href="#sobre-mi" data-i18n="footer.about" class="hover:text-accent transition-colors duration-200">
          Sobre mí
        </a>
      </li>
      <li>
        <a href="#estudios" data-i18n="nav.education" class="hover:text-accent transition-colors duration-200">
          Estudios
        </a>
      </li>
      <li>
        <a href="#habilidades" data-i18n="nav.skills" class="hover:text-accent transition-colors duration-200">
