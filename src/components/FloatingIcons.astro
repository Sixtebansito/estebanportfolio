---
// Iconos decorativos modernos para el fondo del hero
const icons = [
  {
    name: "Python",
    svg: `<svg xmlns="http://www.w3.org/2000/svg" width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M12 2c-4.66 0 -8.5 3.31 -8.96 7.73l-.04 .27v4l.03 .24c.33 2.65 2.14 4.8 4.71 5.48l.26 .06v-3.78c0 -1.65 1.34 -3 3 -3h5v-5c0 -3.31 -2.69 -6 -6 -6zm-1 4a1 1 0 1 1 0 2a1 1 0 0 1 0 -2zm10 4h-5v5c0 3.31 2.69 6 6 6c4.66 0 8.5 -3.31 8.96 -7.73l.04 -.27v-4l-.03 -.24c-.33 -2.65 -2.14 -4.8 -4.71 -5.48l-.26 -.06v3.78c0 1.65 -1.34 3 -3 3h-5z"/></svg>`,
    className: "top-12 left-[8%] animate-[float_6s_ease-in-out_infinite]"
  },
  {
    name: "Astro",
    svg: `<svg xmlns="http://www.w3.org/2000/svg" width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M4 13a8 8 0 0 1 7 7a6 6 0 0 0 3 -5a9 9 0 0 0 6 -8a3 3 0 0 0 -3 -3a9 9 0 0 0 -8 6a6 6 0 0 0 -5 3" /><path d="M7 14a6 6 0 0 0 -3 6a6 6 0 0 0 6 -3" /><path d="M15 9m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0" /></svg>`,
    className: "top-36 right-[12%] animate-[float_7s_ease-in-out_infinite_reverse]"
  },
  {
    name: "React",
    svg: `<svg xmlns="http://www.w3.org/2000/svg" width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M12 12m-3.5 0a3.5 3.5 0 1 0 7 0a3.5 3.5 0 1 0 -7 0" /><path d="M12 12c-5.523 0 -10 -2.462 -10 -5.5s4.477 -5.5 10 -5.5s10 2.462 10 5.5s-4.477 5.5 -10 5.5z" transform="rotate(45 12 12)" /><path d="M12 12c-5.523 0 -10 -2.462 -10 -5.5s4.477 -5.5 10 -5.5s10 2.462 10 5.5s-4.477 5.5 -10 5.5z" transform="rotate(-45 12 12)" /></svg>`,
    className: "bottom-24 left-[15%] animate-[float_8s_ease-in-out_infinite]"
  },
  {
    name: "Tailwind",
    svg: `<svg xmlns="http://www.w3.org/2000/svg" width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M11.667 6c-2.49 0 -4.044 1.222 -4.667 3.667c.933 -1.223 2.023 -1.68 3.267 -1.375c.71 .174 1.217 .68 1.778 1.24c.916 .912 2 1.968 4.622 1.968c2.489 0 4.043 -1.222 4.666 -3.667c-.933 1.223 -2.023 1.68 -3.266 1.375c-.71 -.174 -1.217 -.68 -1.778 -1.24c-.916 -.912 -1.999 -1.968 -4.622 -1.968z" /><path d="M5 14.5c-2.49 0 -4.044 1.222 -4.667 3.667c.933 -1.223 2.023 -1.68 3.267 -1.375c.71 .174 1.217 .68 1.778 1.24c.916 .912 2 1.968 4.622 1.968c2.489 0 4.043 -1.222 4.666 -3.667c-.933 1.223 -2.023 1.68 -3.266 1.375c-.71 -.174 -1.217 -.68 -1.778 -1.24c-.916 -.912 -1.999 -1.968 -4.622 -1.968z" /></svg>`,
    className: "top-[55%] right-[8%] animate-[float_5s_ease-in-out_infinite_reverse]"
  }
];
---

<div class="absolute inset-0 overflow-hidden pointer-events-none -z-10">
  <div class="absolute w-[500px] h-[500px] bg-accent/10 rounded-full blur-[140px] top-[-10%] left-[-10%] mix-blend-screen"></div>
  <div class="absolute w-[400px] h-[400px] bg-blue-600/10 rounded-full blur-[120px] bottom-[-10%] right-[-10%] mix-blend-screen"></div>

  {icons.map(icon => (
    <div class={`absolute ${icon.className} text-white/15 drop-shadow-[0_0_15px_rgba(255,255,255,0.1)]`}>
      <Fragment set:html={icon.svg} />
    </div>
  ))}
</div>

<style is:global>
  @keyframes float {
    0% { transform: translateY(0px) rotate(0deg); }
    50% { transform: translateY(-18px) rotate(4deg); }
    100% { transform: translateY(0px) rotate(0deg); }
  }
</style>
