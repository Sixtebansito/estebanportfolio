---
interface Props {
  title: string;
  company: string;
  description: string;
  link?: string;
  date: string;
  index: number;
  current?: boolean;
}

const { title, company, description, date, index, current = false } = Astro.props;
---

<div
  class="reveal motion-card rounded-2xl bg-[#151514]/55 backdrop-blur-md border border-white/10 p-6 sm:p-7 shadow-lg"
  style={`transition-delay: ${(index % 4) * 75}ms;`}
>
  <!-- Timeline marker aligned cleanly on left border -->
  <span
    aria-hidden="true"
    class={`absolute -left-[35px] sm:-left-[43px] top-7 flex size-3.5 items-center justify-center rounded-full ${
      current ? "bg-accent shadow-[0_0_12px_rgba(74,222,128,0.85)]" : "bg-white/35 border border-white/30"
    }`}
  >
    {current && <span class="absolute inline-flex size-full rounded-full bg-accent opacity-75 animate-ping"></span>}
  </span>

  <div class="grid gap-5 md:grid-cols-5 md:items-start">
    <div class="md:col-span-2 flex flex-col gap-1.5">
      <div class="flex flex-wrap items-center gap-2">
        <time
          class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-bold uppercase tracking-wider border ${
            current
              ? "bg-accent/15 text-accent border-accent/40"
              : "bg-white/5 text-gray-300 border-white/15"
          }`}
          data-i18n={`exp.job${index}.date`}
        >
          {date}
        </time>
      </div>
      <h3 class="text-xl font-bold text-white mt-1" data-i18n={`exp.job${index}.title`}>{title}</h3>
      <h4 class="font-semibold text-base text-accent" data-i18n={`exp.job${index}.company`}>{company}</h4>
    </div>

    <div class="text-gray-300 leading-relaxed md:col-span-3 text-sm sm:text-base">
      <p data-i18n={`exp.job${index}.desc`}>{description}</p>
    </div>
  </div>
</div>
