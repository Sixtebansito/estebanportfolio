---
import { translations } from "../data/translations"
---

<header id="main-header" class="fixed top-0 left-0 w-full z-50 transition-colors duration-300 bg-transparent py-5">
  <div class="max-w-7xl mx-auto px-6 flex justify-between items-center">
    <!-- Logo -->
    <a href="#inicio" class="text-2xl font-black tracking-widest uppercase text-white hover:text-accent transition-colors">
      Esteban<span class="text-accent">.</span>
    </a>

    <!-- Navigation & Language Switcher -->
    <div class="flex items-center gap-x-6">
      <nav class="hidden md:flex flex-row gap-x-8 items-center">
        <a href="#inicio" data-i18n="nav.home" class="text-sm font-bold uppercase tracking-wider text-white hover:text-accent transition-colors">Inicio</a>
        <a href="#sobre-mi" data-i18n="nav.about" class="text-sm font-bold uppercase tracking-wider text-white hover:text-accent transition-colors">Sobre mí</a>
        <a href="#experiencia" data-i18n="nav.experience" class="text-sm font-bold uppercase tracking-wider text-white hover:text-accent transition-colors">Experiencia</a>
        <a href="#proyectos" data-i18n="nav.projects" class="text-sm font-bold uppercase tracking-wider text-white hover:text-accent transition-colors">Proyectos</a>
        <a href="#contacto" data-i18n="nav.contact" class="text-sm font-bold uppercase tracking-wider text-white hover:text-accent transition-colors">Contacto</a>
      </nav>

      <!-- Language Switcher Toggle -->
      <div class="flex items-center bg-white/10 backdrop-blur-md p-1 rounded-full border border-white/15 text-xs font-bold shadow-inner">
        <button
          id="btn-lang-es"
          type="button"
          aria-label="Cambiar a Español"
          class="lang-btn px-3 py-1 rounded-full transition-all duration-300 bg-accent text-white shadow-sm font-bold cursor-pointer"
          data-lang="es"
        >
          ES
        </button>
        <button
          id="btn-lang-en"
          type="button"
          aria-label="Switch to English"
          class="lang-btn px-3 py-1 rounded-full transition-all duration-300 text-white/70 hover:text-white cursor-pointer"
          data-lang="en"
        >
          EN
        </button>
      </div>
    </div>
  </div>
</header>

<script>
  import { translations } from "../data/translations";

  // Scroll effect on header
  const header = document.getElementById('main-header');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      header?.classList.remove('bg-transparent', 'py-5');
      header?.classList.add('bg-[#111111]/95', 'backdrop-blur-md', 'py-4', 'shadow-lg');
    } else {
      header?.classList.add('bg-transparent', 'py-5');
      header?.classList.remove('bg-[#111111]/95', 'backdrop-blur-md', 'py-4', 'shadow-lg');
    }
  });

  // Language switcher logic
  function setLanguage(lang: 'es' | 'en') {
    try {
      localStorage.setItem('portfolio_lang', lang);
    } catch (e) {}

    document.documentElement.lang = lang;

    const btnEs = document.getElementById('btn-lang-es');
    const btnEn = document.getElementById('btn-lang-en');

    if (lang === 'es') {
      btnEs?.classList.add('bg-accent', 'text-white', 'shadow-sm', 'font-bold');
      btnEs?.classList.remove('text-white/70');
      btnEn?.classList.remove('bg-accent', 'text-white', 'shadow-sm', 'font-bold');
      btnEn?.classList.add('text-white/70');
    } else {
      btnEn?.classList.add('bg-accent', 'text-white', 'shadow-sm', 'font-bold');
      btnEn?.classList.remove('text-white/70');
      btnEs?.classList.remove('bg-accent', 'text-white', 'shadow-sm', 'font-bold');
      btnEs?.classList.add('text-white/70');
    }

    // Translate DOM elements with data-i18n
    const elements = document.querySelectorAll<HTMLElement>('[data-i18n]');
    elements.forEach((el) => {
      const key = el.getAttribute('data-i18n');
      if (key && translations[lang] && translations[lang][key]) {
        el.innerHTML = translations[lang][key];
      }
    });

    // Update dynamic CV download button in Hero
    const heroCvBtn = document.getElementById('hero-cv-btn') as HTMLAnchorElement | null;
    if (heroCvBtn) {
      if (lang === 'en') {
        heroCvBtn.href = 'cv_en.pdf';
        heroCvBtn.setAttribute('download', 'Esteban_Munoz_CV_EN.pdf');
      } else {
        heroCvBtn.href = 'cv.pdf';
        heroCvBtn.setAttribute('download', 'Esteban_Munoz_CV_ES.pdf');
      }
    }

    window.dispatchEvent(new CustomEvent('languageChanged', { detail: { lang } }));
  }

  function initLanguage() {
    let savedLang: 'es' | 'en' = 'es';
    try {
      const stored = localStorage.getItem('portfolio_lang');
      if (stored === 'es' || stored === 'en') {
        savedLang = stored;
      }
    } catch (e) {}

    setLanguage(savedLang);

    document.getElementById('btn-lang-es')?.addEventListener('click', () => setLanguage('es'));
    document.getElementById('btn-lang-en')?.addEventListener('click', () => setLanguage('en'));
  }

  // Run on page load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLanguage);
  } else {
    initLanguage();
  }
</script>
