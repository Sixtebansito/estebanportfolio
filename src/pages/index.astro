---
import Layout from "../layouts/Layout.astro"
import "../styles/global.css"
import Hero from "../components/Hero.astro"
import Services from "../components/Services.astro"
import About from "../components/About.astro"
import Experience from "../components/Experience.astro"
import Projects from "../components/Proyectos.astro"
---

<Layout>
  <main class="w-full">
    <!-- 1. Inicio / Hero -->
    <Hero />

    <!-- 2. Servicios de Creación Web & Emprendimiento -->
    <Services />

    <!-- 3. Sobre Mí -->
    <About />

    <!-- 4. Experiencia Laboral -->
    <section id="experiencia" class="py-32 px-6 bg-[#111111]">
      <div class="max-w-7xl mx-auto">
        <div class="mb-16 reveal">
          <span class="glint-subheading">Trayectoria</span>
          <h2 class="text-4xl md:text-5xl font-bold text-white mt-2">
            Experiencia <span class="text-accent">laboral & comercial.</span>
          </h2>
          <p class="text-gray-400 text-base mt-3 max-w-2xl">
            Roles de alta responsabilidad en gestión operativa, cobranzas, logística y soporte estratégico, complementados con desarrollo de software.
          </p>
        </div>
        <div class="reveal" style="animation-delay: 200ms;">
          <Experience />
        </div>
      </div>
    </section>

    <!-- 5. Proyectos Destacados -->
    <Projects />

    <!-- 6. Contacto & Conversión -->
    <section id="contacto" class="relative py-32 px-6 bg-[#141414] text-center overflow-hidden">
      <!-- Background Glow -->
      <div class="absolute inset-0 flex items-center justify-center pointer-events-none -z-10">
        <div class="w-[600px] h-[350px] bg-accent/10 rounded-full blur-[150px]"></div>
      </div>

      <div class="max-w-4xl mx-auto reveal">
        <span class="glint-subheading">Ponte en Contacto</span>
        <h2 class="text-4xl sm:text-6xl font-black text-white mt-3 mb-6 tracking-tight">
          ¿Tienes una idea o proyecto en mente? <br/>
          <span class="text-white">Hagámoslo </span><span class="text-accent">realidad.</span>
        </h2>
        <p class="text-gray-400 text-base sm:text-lg max-w-2xl mx-auto mb-12">
          Ya sea que busques una página web moderna para tu emprendimiento, una aplicación a medida o sumar un profesional versátil a tu equipo, conversemos.
        </p>

        <!-- Direct Contact Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6 mb-12 text-left">
          
          <!-- Email Card -->
          <a 
            href="mailto:dannygghhm@gmail.com" 
            class="p-6 rounded-2xl bg-white/5 border border-white/5 hover:border-accent/40 transition-all group flex flex-col justify-between hover:-translate-y-1"
          >
            <div>
              <div class="size-10 rounded-lg bg-accent/10 text-accent flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </div>
              <span class="text-xs font-bold uppercase tracking-wider text-gray-400 block mb-1">Correo Electrónico</span>
              <p class="text-sm font-semibold text-white break-all">dannygghhm@gmail.com</p>
            </div>
            <span class="text-xs text-accent mt-4 font-bold flex items-center gap-1 group-hover:translate-x-1 transition-transform">
              Escríbeme &rarr;
            </span>
          </a>

          <!-- WhatsApp Card -->
          <a 
            href="https://wa.me/593983958430/?text=Hola%20Esteban,%20vi%20tu%20portafolio%20y%20me%20gustar%C3%ADa%20conversar%20sobre%20un%20proyecto%20web" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="p-6 rounded-2xl bg-white/5 border border-white/5 hover:border-accent/40 transition-all group flex flex-col justify-between hover:-translate-y-1"
          >
            <div>
              <div class="size-10 rounded-lg bg-emerald-500/10 text-emerald-400 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                <svg class="size-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.698c.969.585 1.961.895 2.796.896h.005c3.181 0 5.767-2.587 5.767-5.766.001-3.182-2.585-5.783-5.772-5.783zm3.393 8.163c-.144.405-.837.774-1.17.824-.312.045-.694.072-2.073-.487-1.764-.714-2.899-2.508-2.987-2.624-.088-.116-.715-.951-.715-1.815 0-.864.453-1.289.614-1.464.161-.176.353-.22.47-.22.118 0 .235.001.338.006.107.005.25-.041.391.297.144.346.49 1.196.533 1.284.043.088.072.191.014.307-.058.116-.087.188-.173.289l-.26.307c-.088.096-.18.201-.077.378.103.176.458.756.984 1.224.678.604 1.25.791 1.427.879.177.088.281.073.385-.044.103-.117.441-.513.559-.689.118-.176.236-.147.397-.088.162.059 1.026.484 1.203.572.176.088.294.132.338.206.044.073.044.426-.1.831z"/>
                </svg>
              </div>
              <span class="text-xs font-bold uppercase tracking-wider text-gray-400 block mb-1">WhatsApp</span>
              <p class="text-sm font-semibold text-white">Chat Inmediato</p>
            </div>
            <span class="text-xs text-accent mt-4 font-bold flex items-center gap-1 group-hover:translate-x-1 transition-transform">
              Enviar Mensaje &rarr;
            </span>
          </a>

          <!-- LinkedIn Card -->
          <a 
            href="https://www.linkedin.com/in/esteban-munoz-/" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="p-6 rounded-2xl bg-white/5 border border-white/5 hover:border-accent/40 transition-all group flex flex-col justify-between hover:-translate-y-1 sm:col-span-2 md:col-span-1"
          >
            <div>
              <div class="size-10 rounded-lg bg-blue-500/10 text-blue-400 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                <svg class="size-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                </svg>
              </div>
              <span class="text-xs font-bold uppercase tracking-wider text-gray-400 block mb-1">LinkedIn</span>
              <p class="text-sm font-semibold text-white">/in/esteban-munoz-</p>
            </div>
            <span class="text-xs text-accent mt-4 font-bold flex items-center gap-1 group-hover:translate-x-1 transition-transform">
              Conectar en LinkedIn &rarr;
            </span>
          </a>

        </div>

        <!-- Trust Badges -->
        <div class="inline-flex flex-wrap justify-center items-center gap-6 text-xs text-gray-400 pt-4 border-t border-white/10">
          <span class="flex items-center gap-1.5"><span class="text-accent font-bold">✓</span> Respuesta en menos de 24 horas</span>
          <span class="flex items-center gap-1.5"><span class="text-accent font-bold">✓</span> Asesoría y cotización sin compromiso</span>
          <span class="flex items-center gap-1.5"><span class="text-accent font-bold">✓</span> Ubicación: Quito, Ecuador / Remoto global</span>
        </div>

      </div>
    </section>
  </main>
</Layout>