---
import Layout from "../layouts/Layout.astro"
import "../styles/global.css"
import AboutMe from "../components/AboutMe.astro"
import Briefcase from "../assets/suitcase.svg"
import CodeIcon from "../assets/code.svg"
import Experience from "../components/Experience.astro"
import ProfileCheck from "../assets/check.svg"
import Projects from "../components/Proyectos.astro"
import SectionContainer from "../components/SectionContainer.astro"
import Hero from "../components/Hero.astro"
import TitleSection from "../components/TitleSection.astro"
---

<Layout>
  <main class="px-4">
    <SectionContainer class="py-16 md:py-36">
      <Hero id="inicio">
      </slot>
    </Hero>
    </SectionContainer>
    <div class="space-y-24">
    <SectionContainer id="experiencia">
      <TitleSection>
        <Briefcase class="size-8" />
        Experiencia laboral
      </TitleSection>
      <Experience />
    </SectionContainer>
    <SectionContainer id="proyectos">
      <TitleSection>
        <CodeIcon class="size-7" />
        Proyectos
      </TitleSection>
      <Projects />
    </SectionContainer>
    <SectionContainer id="sobre-mi">
      <TitleSection>
        <ProfileCheck class="size-8" />
        Sobre mí
      </TitleSection>
      <AboutMe />
    </SectionContainer>
  </div>
  </main>
</Layout>
