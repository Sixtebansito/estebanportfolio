---
import Layout from "../layouts/Layout.astro"
import "../styles/global.css"
import About from "../components/About.astro"
import Education from "../components/Education.astro"
import Skills from "../components/Skills.astro"
import Experience from "../components/Experience.astro"
import Projects from "../components/Proyectos.astro"
import Hero from "../components/Hero.astro"

const waEsUrl =
  "https://wa.me/593983958430?text=Hola%20Esteban%2C%20vi%20tu%20portafolio%20y%20me%20gustar%C3%ADa%20conversar%20contigo."
---

<Layout>
  <main class="w-full">
    <!-- Inicio -->
    <Hero />

    <!-- Sobre Mí -->
    <About />

    <!-- Estudios y Certificaciones -->
    <Education />

    <!-- Stack Tecnológico -->
    <Skills />

    <!-- Experiencia -->
    <section id="experiencia" class="scroll-mt-16 py-28 px-6 bg-transparent border-t border-white/5">
      <div class="max-w-7xl mx-auto">
        <div class="mb-14 reveal">
          <span class="glint-subheading" data-i18n="exp.sub">Trayectoria</span>
          <h2 class="text-4xl md:text-5xl font-bold text-white mt-2" data-i18n="exp.title">
            Mi experiencia <span class="text-accent">laboral.</span>
          </h2>
        </div>
        <div>
          <Experience />
        </div>
      </div>
    </section>

    <!-- Proyectos -->
    <Projects />

    <!-- Contacto -->
    <section id="contacto" class="scroll-mt-16 py-28 px-6 bg-transparent border-t border-white/5 text-center">
      <div class="max-w-4xl mx-auto reveal">
        <span class="glint-subheading" data-i18n="contact.sub">Contáctame</span>
        <h2 class="text-4xl sm:text-5xl md:text-7xl font-bold text-white mt-4 mb-6" data-i18n="contact.title">
          ¿Tienes un proyecto en mente? <br/> <span class="text-accent">Hagámoslo realidad.</span>
        </h2>
        <p class="text-gray-400 max-w-xl mx-auto mb-10 text-base md:text-lg" data-i18n="contact.desc">
          Disponible para proyectos web B2B, desarrollo Full Stack y oportunidades de ingeniería de software en Ecuador o remoto.
        </p>

        <div class="flex flex-wrap items-center justify-center gap-4">
          <a
            id="contact-whatsapp-btn"
            href={waEsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="motion-btn inline-flex items-center justify-center gap-3 px-8 py-4 text-white uppercase tracking-widest text-xs sm:text-sm font-bold bg-[#22c55e] hover:bg-[#16a34a] rounded-full shadow-xl shadow-accent/25 hover:shadow-accent/40 min-h-[48px]"
          >
            <svg class="size-5 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12.04 2a9.94 9.94 0 0 0-8.48 15.16L2 22l4.98-1.52A9.95 9.95 0 1 0 12.04 2zm0 18.17a8.18 8.18 0 0 1-4.18-1.14l-.3-.18-3.1.94.96-3.02-.2-.31a8.2 8.2 0 1 1 6.82 3.71zm4.5-6.13c-.25-.12-1.46-.72-1.69-.8-.22-.09-.39-.13-.55.12-.17.25-.64.8-.79.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-2-1.24a7.53 7.53 0 0 1-1.39-1.72c-.15-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.13-.15.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.12-.55-1.34-.76-1.83-.2-.48-.4-.41-.55-.42h-.47c-.16 0-.43.06-.65.31-.22.25-.86.84-.86 2.05s.88 2.38 1 2.54c.13.17 1.73 2.64 4.19 3.7.59.25 1.04.41 1.4.52.59.19 1.12.16 1.54.1.47-.07 1.46-.6 1.66-1.17.21-.58.21-1.07.15-1.17-.07-.11-.23-.17-.48-.29z"/>
            </svg>
            <span data-i18n="contact.wa_btn">Escríbeme por WhatsApp</span>
          </a>

          <a
            href="mailto:dannygghhm@gmail.com"
            class="motion-btn inline-flex items-center justify-center gap-3 px-8 py-4 text-white uppercase tracking-widest text-xs sm:text-sm font-bold bg-white/[0.06] hover:bg-white/[0.12] border border-white/15 hover:border-accent/60 rounded-full backdrop-blur-md min-h-[48px]"
          >
            <svg class="size-5 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect width="20" height="16" x="2" y="4" rx="2" />
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
            </svg>
            <span data-i18n="contact.btn">Envíame un correo</span>
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>
